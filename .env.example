# Copy this file to .env and replace every placeholder before running Pluto.
# Mock mode keeps external observability and supporter integrations optional.

NODE_ENV=development
TOKEN=<your-discord-bot-token>
PREFIX=<command-prefix>
PROJECT_VERSION=<version>
KH_API_URL=https://api.example.invalid
KH_API_TOKEN=<your-api-token>
R_HOST=cache.example.invalid
R_PORT=6379
R_DB=0
R_PASS=<your-cache-password>
API_PORT=2090
API_URL=https://app.example.invalid
LOG_LEVEL=Info
KH_PLUTO_CLIENT_KEY=<your-client-key>
APP_OWNER_ID=<your-discord-owner-id>
BULL_BOARD_USERNAME=<your-dashboard-username>
BULL_BOARD_PASSWORD=<your-dashboard-password>
API_KEY=<your-api-key>
MAINTENANCE_MODE=false

USE_MOCK_DATA=true
MOCK_GUILD_BETTING_CHAN_ID=<your-test-channel-id>
DEV_GUILD_GAMES_CATEGORY_ID=<your-test-category-id>
MOCK_GUILD_SPORT=nba

# Required when USE_MOCK_DATA is false.
# PATREON_API_URL=https://supporter-api.example.invalid
# AXIOM_DATASET=<your-observability-dataset>
# AXIOM_API_TOKEN=<your-observability-token>
# AXIOM_ORG_ID=<your-observability-org-id>

# Weekly recap digest (optional). Posts to the betting channel unless
# RECAP_CHANNEL_ID is set. NBA recaps and period winners are off by default.
# RECAP_ENABLED=true
# RECAP_GUILD_IDS=<comma-separated-guild-ids>
# RECAP_CHANNEL_ID=<your-recap-channel-id>
# RECAP_CRON=0 9 * * 1
# RECAP_NBA_ENABLED=false
# PERIOD_WINNERS_ENABLED=false
# PERIOD_WINNERS_WEEKLY_CRON=30 9 * * 1
# PERIOD_WINNERS_MONTHLY_CRON=30 9 1 * *
